+\[
+ \begin{array}{c|l}
+ 2&e_{12}-3e_{13},\quad e_{14},\quad 2e_{13}+e_{23},\quad e_{24},\\
+ 3&e_{124}-3e_{134},\quad 2e_{134}+e_{234}.
